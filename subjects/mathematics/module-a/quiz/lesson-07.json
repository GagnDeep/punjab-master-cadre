{
  "id": "quiz-07",
  "title": "Quiz 07",
  "questions": [
    {
      "id": "q1",
      "topic": "Complex",
      "q": "The value of i^2023 is:",
      "options": [
        "i",
        "-i",
        "1",
        "-1"
      ],
      "answerIndex": 1,
      "explanation": "2023 / 4 leaves remainder 3. So i^2023 = i^3 = -i."
    },
    {
      "id": "q2",
      "topic": "Complex",
      "q": "The conjugate of -3 + 4i is:",
      "options": [
        "3 + 4i",
        "-3 - 4i",
        "3 - 4i",
        "4 - 3i"
      ],
      "answerIndex": 1,
      "explanation": "Conjugate reverses the sign of the imaginary part only."
    },
    {
      "id": "q3",
      "topic": "Complex",
      "q": "Modulus of z = 5 - 12i is:",
      "options": [
        "17",
        "13",
        "7",
        "60"
      ],
      "answerIndex": 1,
      "explanation": "Modulus = sqrt(5^2 + (-12)^2) = sqrt(25 + 144) = sqrt(169) = 13."
    },
    {
      "id": "q4",
      "topic": "Complex",
      "q": "If 1, w, w^2 are cube roots of unity, then 1 + w + w^2 =",
      "options": [
        "1",
        "3",
        "0",
        "w"
      ],
      "answerIndex": 2,
      "explanation": "The sum of the nth roots of unity is always zero."
    },
    {
      "id": "q5",
      "topic": "Complex",
      "q": "The polar form involves representing a complex number using:",
      "options": [
        "Sine and Cosine",
        "Tangent and Secant",
        "Logs and Exponentials",
        "Real numbers only"
      ],
      "answerIndex": 0,
      "explanation": "Polar form is r(cos x + i sin x)."
    },
    {
      "id": "q6",
      "topic": "Complex",
      "q": "Standard form of (1+i)/(1-i) is:",
      "options": [
        "1",
        "-1",
        "i",
        "-i"
      ],
      "answerIndex": 2,
      "explanation": "Multiply by (1-i)'s conjugate (1+i)/(1+i) to get (1+2i-1)/2 = i."
    },
    {
      "id": "q7",
      "topic": "Complex",
      "q": "Argument of -1 + i is:",
      "options": [
        "pi/4",
        "3pi/4",
        "-pi/4",
        "5pi/4"
      ],
      "answerIndex": 1,
      "explanation": "It lies in 2nd quadrant. Angle is pi - pi/4 = 3pi/4."
    },
    {
      "id": "q8",
      "topic": "Complex",
      "q": "For any complex number z, z * conjugate(z) is:",
      "options": [
        "|z|",
        "|z|^2",
        "0",
        "2 Re(z)"
      ],
      "answerIndex": 1,
      "explanation": "This is a fundamental identity representing the square of the distance from origin."
    }
  ]
}